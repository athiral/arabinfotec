# 1. Enable Output Compression (mod_deflate) for all HTML, text, CSS, JS, SVG, and JSON
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 2. Enable Gzip Compression (mod_gzip) fallback
<IfModule mod_gzip.c>
    mod_gzip_on Yes
    mod_gzip_dechunk Yes
    mod_gzip_item_include file \.(html?|txt|css|js|php|pl|svg)$
    mod_gzip_item_include mime ^text/.*
    mod_gzip_item_include mime ^application/x-javascript.*
    mod_gzip_item_include mime ^application/javascript.*
    mod_gzip_item_include mime ^application/json.*
    mod_gzip_item_include mime ^image/svg\+xml.*
</IfModule>

# 3. Leverage Browser Caching (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images and Media
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # HTML and dynamic documents
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 4. Cache-Control Headers (mod_headers)
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, private, must-revalidate"
    </FilesMatch>
</IfModule>

# Suppress PHP error display on production (mod_php, mod_php7, mod_php8, and mod_lsapi)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>
<IfModule lsapi_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
DirectorySlash Off

# 1. Default directory index
DirectoryIndex index.php index.html

# 2. Redirect direct requests for index.php or index.html to clean root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s+([^?]*?)index\.(php|html)[\s?] [NC]
RewriteRule ^(.*?)index\.(php|html)$ %1 [R=301,L,NE]

# 3. Redirect direct requests for .html (e.g. /about.html) to clean URL without extension
RewriteCond %{THE_REQUEST} \s+([^?\s]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !index\.html$ [NC]
RewriteRule ^(.*)\.html$ %1 [R=301,L,NE]

# Redirect direct request for download-brochure.php or download-brochure to /downloads/ait-brochure
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s+([^?\s]*)/download-brochure(?:\.php)?[\s?] [NC]
RewriteRule ^(.*)download-brochure(?:\.php)?$ %1/downloads/ait-brochure [R=301,L,NE]


# 4. Redirect direct requests for .php to clean URL (removes .php from browser address bar)
# Explicitly exclude POST requests, send-inquiry.php, and send-enquiry.php so contact form is never affected
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s+([^?\s]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !send-inquiry\.php$ [NC]
RewriteCond %{REQUEST_URI} !send-enquiry\.php$ [NC]
RewriteCond %{REQUEST_URI} !send-brochure\.php$ [NC]
RewriteCond %{REQUEST_URI} !download-brochure\.php$ [NC]
RewriteCond %{REQUEST_URI} !index\.php$ [NC]
RewriteRule ^(.*)\.php$ %1 [R=301,L,NE]

# 5. Remove trailing slash from non-directories (e.g. /about/ -> /about)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s+([^?\s]+)/+[\s?] [NC]
RewriteRule ^(.+)/$ %1 [R=301,L,NE]

# 6. Special case: /solutions and /solutions/ load solutions.php
RewriteRule ^solutions/?$ solutions.php [L]

# Special case: /downloads/ait-brochure loads download-brochure.php
RewriteRule ^downloads/ait-brochure/?$ download-brochure.php [L,QSA]

# 7. Add trailing slash to any real subdirectories (e.g. projects/bayatplaza -> projects/bayatplaza/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^.*/solutions/?$ [NC]
RewriteCond %{THE_REQUEST} \s+([^?\s]+)[\s?] [NC]
RewriteRule ^(.*[^/])$ %1/ [R=301,L,NE]

# 8. Internally load .php file when clean extensionless URL is requested (e.g. /about loads about.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# 9. Fallback: internally load .html file if clean URL requested and .html exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

</IfModule>
